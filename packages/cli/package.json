{
  "name": "@kitn.ai/cli",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "description": "The kai command line for @kitn.ai/ui: scaffold a project or add a block to one, diagnose its wiring, and run the construct dev/eject/compile tooling.",
  "keywords": [
    "cli",
    "kitn",
    "kai",
    "ui",
    "chat",
    "scaffold"
  ],
  "homepage": "https://ui.kitn.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitn-ai/ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/kitn-ai/ui/issues"
  },
  "bin": {
    "kai": "./bin/kai.js"
  },
  "nx": {
    "name": "cli",
    "implicitDependencies": [
      "ui",
      "create-kai"
    ],
    "targets": {
      "build": {
        "dependsOn": [],
        "inputs": [
          "default",
          "{workspaceRoot}/packages/ui/mcp/construct/**/*",
          "{workspaceRoot}/packages/ui/apps/**/*"
        ]
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "!bin/**/*.test.js"
  ],
  "scripts": {
    "build": "KAI_BUILD=doctor vite build --config config/vite/node.ts && KAI_BUILD=construct-cli vite build --config config/vite/node.ts && KAI_BUILD=builder vite build --config config/vite/page.ts && KAI_BUILD=theme-studio vite build --config config/vite/page.ts",
    "prepublishOnly": "npm run build && node scripts/verify-pack-weight.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:bundle-shape": "node scripts/verify-bundle-shape.mjs --self-test && node scripts/verify-bundle-shape.mjs",
    "verify:pack": "node scripts/verify-pack-weight.mjs --self-test && node scripts/verify-pack-weight.mjs",
    "lint:cli-invocations": "node scripts/lint-cli-invocations.mjs --self-test && node scripts/lint-cli-invocations.mjs"
  },
  "dependencies": {
    "create-kai": "^0.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kitn.ai/ui": "workspace:*",
    "@tailwindcss/postcss": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
