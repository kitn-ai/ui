node-linker=hoisted
enable-pre-post-scripts=true

# Internal workspace ranges are PLAIN literals here (npm has no `workspace:` protocol, so a
# published tarball must carry a real range), and without this pnpm resolves them from the
# REGISTRY: a local build then compiles against a published copy of the kit/create-kai rather
# than the tree under test, and a range bumped ahead of its publish cannot be resolved at all
# (the ERR_PNPM_OUTDATED_LOCKFILE wall the 0.33.0 release hit). Only two edges are affected
# today, @kitn.ai/mcp -> @kitn.ai/ui and @kitn.ai/cli -> create-kai, because every other
# workspace importer already uses `workspace:`.
link-workspace-packages=true
